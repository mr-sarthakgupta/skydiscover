 308 | def _resolve_checkpoint(spec: dict[str, Any]) -> tuple[Path, str, Path]:
 309 |     ckpt_root = Path(os.environ.get("CKPT_PATH", str(PROTEINA_ROOT / "ckpts"))).expanduser()
 310 |     selection = spec["checkpoint_selection"]
 311 |     ckpt_name = _ALLOWED_CHECKPOINT_ALIASES.get(selection, selection)
 312 |     if "/" in ckpt_name or "\\" in ckpt_name or not ckpt_name.endswith(".ckpt"):
 313 |         raise CandidateValidationError("checkpoint_selection must be an allowed alias or checkpoint filename")
 314 |     ckpt_file = ckpt_root / ckpt_name
 315 |     ae_file = ckpt_root / "complexa_ae.ckpt"
 316 |     return ckpt_root, ckpt_name, ae_file
 317 | 
 318 | 
 319 | def _hydra_list(values: list[Any]) -> str:
 320 |     return json.dumps(values, separators=(",", ":"))
