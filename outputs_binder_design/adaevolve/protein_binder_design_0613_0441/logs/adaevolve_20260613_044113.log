  42 | class CandidateValidationError(ValueError):
  43 |     """Raised when an evolved candidate violates the benchmark contract."""
  44 | 
  45 | 
  46 | def _load_metadata() -> dict[str, Any]:
  47 |     with TARGET_METADATA_PATH.open() as f:
  48 |         return json.load(f)
  49 | 
  50 | 
  51 | TARGET_METADATA = _load_metadata()
  52 | ALLOWED_HOTSPOTS = set(TARGET_METADATA["target"]["allowed_hotspots"])
  53 | INTERFACE_HOTSPOTS = [item["hotspot"] for item in TARGET_METADATA["interface_hotspot_candidates"]]
  54 | PRIOR_HOTSPOTS = TARGET_METADATA["prior_art_hotspots"]["hotspots"]
  55 | TARGET_PDB_PATH = ASSETS_DIR / TARGET_METADATA["target"]["target_pdb"]
  56 | 
  57 | 
  58 | def _is_module_docstring(node: ast.AST) -> bool:
  59 |     return isinstance(node, ast.Expr) and isinstance(node.value, ast.Constant) and isinstance(node.value.value, str)
  60 | 
  61 | 
  62 | def _is_main_guard(node: ast.AST) -> bool:
  63 |     if not isinstance(node, ast.If) or node.orelse:
  64 |         return False
  65 |     test = node.test
  66 |     if not isinstance(test, ast.Compare) or len(test.ops) != 1 or len(test.comparators) != 1:
  67 |         return False
  68 |     return (
  69 |         isinstance(test.left, ast.Name)
  70 |         and test.left.id == "__name__"
  71 |         and isinstance(test.ops[0], ast.Eq)
  72 |         and isinstance(test.comparators[0], ast.Constant)
  73 |         and test.comparators[0].value == "__main__"
  74 |     )
  75 | 
  76 | 
  77 | def _validate_candidate_source(program_path: str) -> None:
  78 |     source = Path(program_path).read_text()
  79 |     tree = ast.parse(source, filename=program_path)
  80 |     has_entrypoint = False
  81 | 
  82 |     for node in tree.body:
  83 |         if _is_module_docstring(node) or _is_main_guard(node):
  84 |             continue
  85 |         if isinstance(node, ast.ImportFrom):
  86 |             if node.module not in _ALLOWED_IMPORT_MODULES:
  87 |                 raise CandidateValidationError(f"import from {node.module!r} is not allowed")
  88 |             continue
  89 |         if isinstance(node, ast.Assign):
  90 |             try:
  91 |                 ast.literal_eval(node.value)
  92 |             except Exception as exc:
  93 |                 raise CandidateValidationError("top-level assignments must be literal constants") from exc
  94 |             continue
  95 |         if isinstance(node, ast.FunctionDef):
  96 |             if node.decorator_list:
  97 |                 raise CandidateValidationError("function decorators are not allowed")
  98 |             if node.name in {"propose_design_run", "run_discovery"}:
  99 |                 has_entrypoint = True
 100 |             for child in ast.walk(node):
 101 |                 if isinstance(child, (ast.Import, ast.ImportFrom)):
 102 |                     raise CandidateValidationError("imports inside evolved functions are not allowed")
 103 |                 if isinstance(child, ast.Call) and isinstance(child.func, ast.Name) and child.func.id in _FORBIDDEN_CALLS:
 104 |                     raise CandidateValidationError(f"call to {child.func.id}() is not allowed")
 105 |             continue
 106 |         raise CandidateValidationError(f"top-level {type(node).__name__} is not allowed")
 107 | 
 108 |     if not has_entrypoint:
 109 |         raise CandidateValidationError("candidate must define propose_design_run() or run_discovery()")
 110 | 
 111 | 
 112 | def _load_candidate_spec(program_path: str) -> dict[str, Any]:
 113 |     _validate_candidate_source(program_path)
 114 |     spec = importlib.util.spec_from_file_location("binder_candidate", program_path)
 115 |     if spec is None or spec.loader is None:
 116 |         raise CandidateValidationError(f"could not load candidate: {program_path}")
 117 |     module = importlib.util.module_from_spec(spec)
 118 |     spec.loader.exec_module(module)
 119 | 
 120 |     fn = getattr(module, "propose_design_run", None) or getattr(module, "run_discovery", None)
 121 |     if fn is None:
 122 |         raise CandidateValidationError("missing propose_design_run() or run_discovery()")
 123 |     result = fn()
 124 |     if not isinstance(result, dict):
 125 |         raise CandidateValidationError("candidate entry point must return a dict")
 126 |     return result
 127 | 
 128 | 
 129 | def _as_int(value: Any, name: str, low: int, high: int) -> int:
 130 |     if isinstance(value, bool):
 131 |         raise CandidateValidationError(f"{name} must be an integer")
 132 |     try:
 133 |         out = int(value)
 134 |     except Exception as exc:
 135 |         raise CandidateValidationError(f"{name} must be an integer") from exc
 136 |     if out < low or out > high:
 137 |         raise CandidateValidationError(f"{name} must be between {low} and {high}")
 138 |     return out
 139 | 
 140 | 
 141 | def _as_float(value: Any, name: str, low: float, high: float) -> float:
 142 |     try:
 143 |         out = float(value)
 144 |     except Exception as exc:
 145 |         raise CandidateValidationError(f"{name} must be a number") from exc
 146 |     if not math.isfinite(out) or out < low or out > high:
 147 |         raise CandidateValidationError(f"{name} must be finite and between {low} and {high}")
 148 |     return out
 149 | 
 150 | 
 151 | def _normalise_hotspots(value: Any) -> list[str]:
 152 |     if value is None:
 153 |         value = PRIOR_HOTSPOTS
 154 |     if not isinstance(value, (list, tuple)):
 155 |         raise CandidateValidationError("hotspot_residues must be a list")
 156 |     hotspots = []
 157 |     for item in value:
 158 |         if not isinstance(item, str):
 159 |             raise CandidateValidationError("hotspot residues must be strings like 'B84'")
 160 |         residue = item.strip().upper()
 161 |         if not re.fullmatch(r"B\d+[A-Z]?", residue):
 162 |             raise CandidateValidationError(f"invalid hotspot residue format: {item!r}")
 163 |         if residue not in ALLOWED_HOTSPOTS:
 164 |             raise CandidateValidationError(f"hotspot {residue!r} is not a modeled chain-B residue")
 165 |         if residue not in hotspots:
 166 |             hotspots.append(residue)
 167 |     if not 1 <= len(hotspots) <= 8:
 168 |         raise CandidateValidationError("choose between 1 and 8 hotspot residues")
 169 |     return hotspots
 170 | 
 171 | 
 172 | def _normalise_length_range(value: Any) -> list[int]:
 173 |     if not isinstance(value, (list, tuple)) or len(value) != 2:
 174 |         raise CandidateValidationError("binder_length must be [min_len, max_len]")
 175 |     low = _as_int(value[0], "binder_length[0]", 40, 220)
 176 |     high = _as_int(value[1], "binder_length[1]", 40, 220)
 177 |     if low > high:
 178 |         raise CandidateValidationError("binder_length minimum cannot exceed maximum")
 179 |     if high - low > 120:
 180 |         raise CandidateValidationError("binder_length range is too wide for this benchmark")
 181 |     return [low, high]
 182 | 
 183 | 
 184 | def _normalise_schedule(value: Any, name: str, allowed_modes: set[str]) -> dict[str, Any]:
 185 |     if value is None:
 186 |         value = {}
 187 |     if not isinstance(value, dict):
 188 |         raise CandidateValidationError(f"{name} must be a dict")
 189 |     mode = str(value.get("mode", "log" if "schedule" in name else "1/t"))
 190 |     if mode not in allowed_modes:
 191 |         raise CandidateValidationError(f"{name}.mode {mode!r} is unsupported")
 192 |     return {"mode": mode, "p": _as_float(value.get("p", 1.0), f"{name}.p", 0.05, 8.0)}
 193 | 
