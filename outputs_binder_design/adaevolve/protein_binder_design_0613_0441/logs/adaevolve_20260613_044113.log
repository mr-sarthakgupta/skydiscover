 323 | def _build_overrides(spec: dict[str, Any], root_path: Path) -> list[str]:
 324 |     ckpt_root, ckpt_name, ae_file = _resolve_checkpoint(spec)
 325 |     sampling = spec["sampling"]
 326 |     search = spec["search"]
 327 |     max_batch_size = max(
 328 |         spec["batch_size"],
 329 |         spec["batch_size"] * search["best_of_n"]["replicas"],
 330 |         spec["batch_size"] * search["beam_search"]["n_branch"] * search["beam_search"]["beam_width"],
 331 |     )
 332 | 
 333 |     return [
 334 |         f"++root_path={root_path}",
 335 |         "++run_name=skydiscover_3di3_il7ra",
 336 |         "++gen_njobs=1",
 337 |         f"++seed={spec['seed']}",
 338 |         f"++ckpt_path={ckpt_root}",
 339 |         f"++ckpt_name={ckpt_name}",
 340 |         f"++autoencoder_ckpt_path={ae_file}",
 341 |         f"++generation.task_name={TARGET_NAME}",
 342 |         f"++generation.target_dict_cfg.{TARGET_NAME}.source=skydiscover",
 343 |         f"++generation.target_dict_cfg.{TARGET_NAME}.target_filename=3di3_chain_b_il7ra_target",
 344 |         f"++generation.target_dict_cfg.{TARGET_NAME}.target_path={TARGET_PDB_PATH}",
 345 |         f"++generation.target_dict_cfg.{TARGET_NAME}.target_input={TARGET_METADATA['target']['proteina_target_input']}",
 346 |         f"++generation.target_dict_cfg.{TARGET_NAME}.hotspot_residues={_hydra_list(spec['hotspot_residues'])}",
 347 |         f"++generation.target_dict_cfg.{TARGET_NAME}.binder_length={_hydra_list(spec['binder_length'])}",
 348 |         f"++generation.target_dict_cfg.{TARGET_NAME}.pdb_id=3di3",
 349 |         f"++generation.dataloader.batch_size={spec['batch_size']}",
 350 |         f"++generation.dataloader.dataset.nres.nsamples={spec['num_length_samples']}",
 351 |         f"++generation.args.nsteps={spec['denoising_steps']}",
 352 |         f"++generation.args.self_cond={str(spec['self_conditioning']).lower()}",
 353 |         f"++generation.search.algorithm={search['algorithm']}",
 354 |         f"++generation.search.max_batch_size={max_batch_size}",
 355 |         f"++generation.search.step_checkpoints={_hydra_list([0, spec['denoising_steps']])}",
 356 |         f"++generation.search.best_of_n.replicas={search['best_of_n']['replicas']}",
 357 |         f"++generation.search.beam_search.n_branch={search['beam_search']['n_branch']}",
 358 |         f"++generation.search.beam_search.beam_width={search['beam_search']['beam_width']}",
 359 |         f"++generation.search.fk_steering.n_branch={search['fk_steering']['n_branch']}",
 360 |         f"++generation.search.fk_steering.beam_width={search['fk_steering']['beam_width']}",
 361 |         f"++generation.search.fk_steering.temperature={search['fk_steering']['temperature']}",
 362 |         f"++generation.search.mcts.n_simulations={search['mcts']['n_simulations']}",
 363 |         f"++generation.search.mcts.exploration_prob={search['mcts']['exploration_prob']}",
 364 |         f"++generation.search.mcts.exploration_constant={search['mcts']['exploration_constant']}",
 365 |         f"++generation.model.bb_ca.schedule.mode={sampling['bb_ca_schedule']['mode']}",
 366 |         f"++generation.model.bb_ca.schedule.p={sampling['bb_ca_schedule']['p']}",
 367 |         f"++generation.model.local_latents.schedule.mode={sampling['local_latents_schedule']['mode']}",
 368 |         f"++generation.model.local_latents.schedule.p={sampling['local_latents_schedule']['p']}",
 369 |         f"++generation.model.bb_ca.gt.mode={sampling['bb_ca_noise']['mode']}",
 370 |         f"++generation.model.bb_ca.gt.p={sampling['bb_ca_noise']['p']}",
 371 |         f"++generation.model.local_latents.gt.mode={sampling['local_latents_noise']['mode']}",
 372 |         f"++generation.model.local_latents.gt.p={sampling['local_latents_noise']['p']}",
 373 |         f"++generation.model.bb_ca.simulation_step_params.sc_scale_noise={sampling['bb_ca_sc_scale_noise']}",
 374 |         f"++generation.model.local_latents.simulation_step_params.sc_scale_noise={sampling['local_latents_sc_scale_noise']}",
 375 |         f"++generation.model.bb_ca.simulation_step_params.sc_scale_score={sampling['bb_ca_sc_scale_score']}",
 376 |         f"++generation.model.local_latents.simulation_step_params.sc_scale_score={sampling['local_latents_sc_scale_score']}",
 377 |     ]
