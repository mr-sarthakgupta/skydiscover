 380 | def _check_runtime_requirements(spec: dict[str, Any]) -> None:
 381 |     if not PROTEINA_ROOT.exists():
 382 |         raise RuntimeError(f"Proteina-Complexa repo not found: {PROTEINA_ROOT}")
 383 |     if not (PROTEINA_ROOT / "configs" / f"{PROTEINA_CONFIG_NAME}.yaml").exists():
 384 |         raise RuntimeError(f"Proteina config not found: {PROTEINA_CONFIG_NAME}")
 385 |     if not TARGET_PDB_PATH.exists():
 386 |         raise RuntimeError(f"target PDB not found: {TARGET_PDB_PATH}")
 387 | 
 388 |     ckpt_root, ckpt_name, ae_file = _resolve_checkpoint(spec)
 389 |     ckpt_file = ckpt_root / ckpt_name
 390 |     missing = []
 391 |     if not ckpt_file.exists():
 392 |         missing.append(str(ckpt_file))
 393 |     if not ae_file.exists():
 394 |         missing.append(str(ae_file))
 395 |     af2_dir = os.environ.get("AF2_DIR")
 396 |     if not af2_dir or not Path(af2_dir).exists():
 397 |         missing.append("AF2_DIR")
 398 |     if missing:
 399 |         raise RuntimeError(
 400 |             "missing Proteina runtime assets: "
 401 |             + ", ".join(missing)
 402 |             + ". Set CKPT_PATH and AF2_DIR, or run with SKYDISCOVER_BINDER_VALIDATE_ONLY=1 for schema checks."
 403 |         )
 404 | 
 405 | 
 406 | def _run_proteina_generate(spec: dict[str, Any], *, stage: str) -> dict[str, Any]:
 407 |     if os.environ.get("SKYDISCOVER_BINDER_VALIDATE_ONLY") == "1":
 408 |         return {
 409 |             "combined_score": 0.0,
 410 |             "validation_only": 1.0,
 411 |             "num_valid_designs": 0,
 412 |             "best_total_reward": 0.0,
 413 |             "mean_total_reward": 0.0,
 414 |             "selected_hotspots": ",".join(spec["hotspot_residues"]),
 415 |             "stage": stage,
 416 |         }
 417 | 
 418 |     _check_runtime_requirements(spec)
 419 |     timeout = int(os.environ.get("SKYDISCOVER_BINDER_TIMEOUT", DEFAULT_TIMEOUT_SECONDS))
 420 | 
 421 |     with tempfile.TemporaryDirectory(prefix=f"skydiscover_binder_{stage}_") as tmp:
 422 |         root_path = Path(tmp) / "generation"
 423 |         root_path.mkdir(parents=True, exist_ok=True)
 424 |         cmd = [
 425 |             str(PROTEINA_PYTHON),
 426 |             "-m",
 427 |             "proteinfoundation.generate",
 428 |             "--config-path",
 429 |             "configs",
 430 |             "--config-name",
 431 |             PROTEINA_CONFIG_NAME,
 432 |             *_build_overrides(spec, root_path),
 433 |         ]
 434 |         env = os.environ.copy()
 435 |         env["HYDRA_FULL_ERROR"] = "1"
 436 |         src_path = str(PROTEINA_ROOT / "src")
 437 |         env["PYTHONPATH"] = src_path + (os.pathsep + env["PYTHONPATH"] if env.get("PYTHONPATH") else "")
 438 | 
 439 |         start = time.time()
 440 |         proc = subprocess.run(
 441 |             cmd,
 442 |             cwd=str(PROTEINA_ROOT),
 443 |             env=env,
 444 |             text=True,
 445 |             stdout=subprocess.PIPE,
 446 |             stderr=subprocess.PIPE,
 447 |             timeout=timeout,
 448 |             check=False,
 449 |         )
 450 |         elapsed = time.time() - start
 451 |         if proc.returncode != 0:
 452 |             raise RuntimeError(
 453 |                 f"Proteina generation failed with exit code {proc.returncode}\n"
 454 |                 f"STDOUT:\n{proc.stdout[-4000:]}\nSTDERR:\n{proc.stderr[-4000:]}"
 455 |             )
 456 |         reward_csvs = sorted(root_path.rglob("rewards_*.csv"))
 457 |         if not reward_csvs:
 458 |             raise RuntimeError(f"Proteina generation completed but no rewards_*.csv found under {root_path}")
 459 |         return _score_reward_csv(reward_csvs[-1], spec=spec, elapsed=elapsed, stage=stage)
 460 | 
 461 | 
 462 | def _finite_float(value: str | None) -> float | None:
 463 |     if value is None or value == "":
 464 |         return None
 465 |     try:
 466 |         parsed = float(value)
 467 |     except ValueError:
 468 |         return None
 469 |     return parsed if math.isfinite(parsed) else None
 470 | 
 471 | 
 472 | def _score_reward_csv(csv_path: Path, *, spec: dict[str, Any], elapsed: float, stage: str) -> dict[str, Any]:
 473 |     rows: list[dict[str, str]] = []
 474 |     with csv_path.open(newline="") as f:
 475 |         reader = csv.DictReader(f)
 476 |         rows.extend(reader)
 477 |     reward_rows = [(row, _finite_float(row.get("total_reward"))) for row in rows]
 478 |     reward_rows = [(row, reward) for row, reward in reward_rows if reward is not None]
 479 |     if not reward_rows:
 480 |         raise RuntimeError(f"no finite total_reward values found in {csv_path}")
 481 | 
 482 |     rewards = [reward for _, reward in reward_rows]
 483 |     best_row, best_reward = max(reward_rows, key=lambda item: item[1])
 484 |     mean_reward = sum(rewards) / len(rewards)
 485 |     # Proteina's default AF2 binder reward is often negative interface PAE loss.
 486 |     # Convert it to a bounded higher-is-better score while preserving ranking.
 487 |     penalty = max(0.0, -best_reward)
 488 |     combined = 1.0 / (1.0 + penalty)
 489 |     diversity_bonus = min(len({row.get("aatype", "") for row, _ in reward_rows}), 10) / 100.0
 490 |     combined_score = min(1.0, combined + diversity_bonus)
 491 | 
 492 |     numeric_components: dict[str, float] = {}
 493 |     for key in best_row:
 494 |         if key in {"pdb_path", "aatype", "sample_type", "metadata_tag"}:
 495 |             continue
 496 |         value = _finite_float(best_row.get(key))
 497 |         if value is not None:
 498 |             numeric_components[f"best_{key}"] = value
 499 | 
 500 |     return {
 501 |         "combined_score": float(combined_score),
 502 |         "best_total_reward": float(best_reward),
 503 |         "mean_total_reward": float(mean_reward),
 504 |         "num_valid_designs": float(len(reward_rows)),
 505 |         "eval_time": float(elapsed),
 506 |         "stage": stage,
 507 |         "selected_hotspot_count": float(len(spec["hotspot_residues"])),
 508 |         "binder_min_len": float(spec["binder_length"][0]),
 509 |         "binder_max_len": float(spec["binder_length"][1]),
 510 |         "denoising_steps": float(spec["denoising_steps"]),
 511 |         "selected_hotspots": ",".join(spec["hotspot_residues"]),
 512 |         "search_algorithm": spec["search"]["algorithm"],
 513 |         "reward_csv": str(csv_path),
 514 |         **numeric_components,
 515 |     }
 516 | 
 517 | 
 518 | def _failure(exc: Exception, *, stage: str) -> dict[str, Any]:
 519 |     return {
 520 |         "combined_score": 0.0,
 521 |         "best_total_reward": float("nan"),
 522 |         "mean_total_reward": float("nan"),
 523 |         "num_valid_designs": 0.0,
 524 |         "stage": stage,
 525 |         "error": str(exc),
 526 |     }
 527 | 
 528 | 
 529 | def _evaluate(program_path: str, *, stage: str) -> dict[str, Any]:
 530 |     try:
 531 |         raw_spec = _load_candidate_spec(program_path)
 532 |         spec = _normalise_spec(raw_spec, stage=stage)
 533 |         result = _run_proteina_generate(spec, stage=stage)
 534 |         result["spec_json"] = json.dumps(spec, sort_keys=True)
 535 |         print(
 536 |             "Evaluation: "
 537 |             f"stage={stage}, combined_score={result['combined_score']:.6f}, "
 538 |             f"best_total_reward={result['best_total_reward']}, "
 539 |             f"hotspots={result.get('selected_hotspots', '')}"
 540 |         )
 541 |         return result
 542 |     except Exception as exc:
 543 |         print(f"Evaluation failed: {exc}")
 544 |         traceback.print_exc()
 545 |         return _failure(exc, stage=stage)
 546 | 
 547 | 
 548 | def evaluate_stage1(program_path: str) -> dict[str, Any]:
 549 |     """Fast cascade stage for schema validation and a tiny Proteina run."""
 550 |     return _evaluate(program_path, stage="stage1")
 551 | 
 552 | 
 553 | def evaluate_stage2(program_path: str) -> dict[str, Any]:
 554 |     """Full benchmark stage for promising candidates."""
 555 |     return _evaluate(program_path, stage="stage2")
 556 | 
 557 | 
 558 | def evaluate(program_path: str) -> dict[str, Any]:
 559 |     """Evaluate one evolved Proteina binder-design run specification."""
 560 |     return evaluate_stage2(program_path)
 561 | 
 562 | 
 563 | if __name__ == "__main__":
 564 |     default_program = BENCHMARK_DIR / "initial_program.py"
 565 |     candidate = sys.argv[1] if len(sys.argv) > 1 else str(default_program)
 566 |     print(json.dumps(evaluate(candidate), indent=2, sort_keys=True))
