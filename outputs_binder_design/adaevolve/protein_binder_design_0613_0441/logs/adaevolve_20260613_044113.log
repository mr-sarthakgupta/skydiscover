  28 | PROTEINA_CONFIG_NAME = "search_binder_local_pipeline"
  29 | PROTEINA_PYTHON = Path(
  30 |     os.environ.get("PROTEINA_PYTHON", sys.executable)
  31 | ).expanduser()
  32 | DEFAULT_TIMEOUT_SECONDS = 7200
  33 | 
  34 | _FORBIDDEN_CALLS = {"eval", "exec", "compile", "open", "__import__", "input"}
  35 | _ALLOWED_IMPORT_MODULES = {"__future__", "typing"}
  36 | _ALLOWED_SEARCH_ALGORITHMS = {"single-pass", "best-of-n", "beam-search", "fk-steering", "mcts"}
  37 | _ALLOWED_CHECKPOINT_ALIASES = {"complexa_default": "complexa.ckpt", "complexa": "complexa.ckpt"}
  38 | _ALLOWED_SCHEDULE_MODES = {"log", "power", "linear"}
  39 | _ALLOWED_NOISE_MODES = {"1/t", "tan", "power", "log", "linear"}
