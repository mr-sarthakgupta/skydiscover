 301 |         spec["search"]["beam_search"]["beam_width"] = min(spec["search"]["beam_search"]["beam_width"], 1)
 302 |         spec["search"]["fk_steering"]["n_branch"] = min(spec["search"]["fk_steering"]["n_branch"], 1)
