 195 | def _normalise_spec(raw: dict[str, Any], *, stage: str) -> dict[str, Any]:
 196 |     sampling = raw.get("sampling", {})
 197 |     if sampling is None:
 198 |         sampling = {}
 199 |     if not isinstance(sampling, dict):
 200 |         raise CandidateValidationError("sampling must be a dict")
 201 | 
 202 |     search = raw.get("search", {})
 203 |     if search is None:
 204 |         search = {}
 205 |     if not isinstance(search, dict):
 206 |         raise CandidateValidationError("search must be a dict")
 207 | 
 208 |     algorithm = str(search.get("algorithm", "best-of-n"))
 209 |     if algorithm not in _ALLOWED_SEARCH_ALGORITHMS:
 210 |         raise CandidateValidationError(f"unsupported search algorithm: {algorithm!r}")
 211 | 
 212 |     nsteps = _as_int(raw.get("denoising_steps", 80), "denoising_steps", 10, 400)
 213 |     if stage == "stage1":
 214 |         nsteps = min(nsteps, _as_int(os.environ.get("SKYDISCOVER_BINDER_STAGE1_NSTEPS", 20), "stage1_nsteps", 5, 80))
 215 |     else:
 216 |         nsteps = min(nsteps, _as_int(os.environ.get("SKYDISCOVER_BINDER_MAX_NSTEPS", 120), "max_nsteps", 10, 400))
 217 | 
 218 |     batch_size = _as_int(raw.get("batch_size", 2), "batch_size", 1, 8)
 219 |     num_length_samples = _as_int(raw.get("num_length_samples", 2), "num_length_samples", 1, 8)
 220 |     if stage == "stage1":
 221 |         batch_size = min(batch_size, 1)
 222 |         num_length_samples = min(num_length_samples, 1)
 223 | 
 224 |     best_of_n = search.get("best_of_n", {}) if isinstance(search.get("best_of_n", {}), dict) else {}
 225 |     beam_search = search.get("beam_search", {}) if isinstance(search.get("beam_search", {}), dict) else {}
 226 |     fk_steering = search.get("fk_steering", {}) if isinstance(search.get("fk_steering", {}), dict) else {}
 227 |     mcts = search.get("mcts", {}) if isinstance(search.get("mcts", {}), dict) else {}
 228 | 
 229 |     spec = {
 230 |         "hotspot_residues": _normalise_hotspots(raw.get("hotspot_residues")),
 231 |         "binder_length": _normalise_length_range(raw.get("binder_length", [70, 110])),
 232 |         "checkpoint_selection": str(raw.get("checkpoint_selection", "complexa_default")),
 233 |         "denoising_steps": nsteps,
 234 |         "self_conditioning": bool(raw.get("self_conditioning", True)),
 235 |         "seed": _as_int(raw.get("seed", 7), "seed", 0, 2**31 - 1),
 236 |         "num_length_samples": num_length_samples,
 237 |         "batch_size": batch_size,
 238 |         "sampling": {
 239 |             "bb_ca_schedule": _normalise_schedule(
 240 |                 sampling.get("bb_ca_schedule", {"mode": "log", "p": 2.0}),
 241 |                 "bb_ca_schedule",
 242 |                 _ALLOWED_SCHEDULE_MODES,
 243 |             ),
 244 |             "local_latents_schedule": _normalise_schedule(
 245 |                 sampling.get("local_latents_schedule", {"mode": "power", "p": 2.0}),
 246 |                 "local_latents_schedule",
 247 |                 _ALLOWED_SCHEDULE_MODES,
 248 |             ),
 249 |             "bb_ca_noise": _normalise_schedule(
 250 |                 sampling.get("bb_ca_noise", {"mode": "1/t", "p": 1.0}),
 251 |                 "bb_ca_noise",
 252 |                 _ALLOWED_NOISE_MODES,
 253 |             ),
 254 |             "local_latents_noise": _normalise_schedule(
 255 |                 sampling.get("local_latents_noise", {"mode": "tan", "p": 1.0}),
 256 |                 "local_latents_noise",
 257 |                 _ALLOWED_NOISE_MODES,
 258 |             ),
 259 |             "bb_ca_sc_scale_noise": _as_float(sampling.get("bb_ca_sc_scale_noise", 0.1), "bb_ca_sc_scale_noise", 0.0, 2.0),
 260 |             "local_latents_sc_scale_noise": _as_float(
 261 |                 sampling.get("local_latents_sc_scale_noise", 0.1),
 262 |                 "local_latents_sc_scale_noise",
 263 |                 0.0,
 264 |                 2.0,
 265 |             ),
 266 |             "bb_ca_sc_scale_score": _as_float(sampling.get("bb_ca_sc_scale_score", 1.0), "bb_ca_sc_scale_score", 0.0, 5.0),
 267 |             "local_latents_sc_scale_score": _as_float(
 268 |                 sampling.get("local_latents_sc_scale_score", 1.0),
 269 |                 "local_latents_sc_scale_score",
 270 |                 0.0,
 271 |                 5.0,
 272 |             ),
 273 |         },
 274 |         "search": {
 275 |             "algorithm": algorithm,
 276 |             "best_of_n": {"replicas": _as_int(best_of_n.get("replicas", 2), "best_of_n.replicas", 1, 8)},
 277 |             "beam_search": {
