  23 | TARGET_METADATA_PATH = ASSETS_DIR / "target_metadata.json"
  24 | TARGET_NAME = "SKY_3DI3_IL7RA"
  25 | PROTEINA_ROOT = Path(
  26 |     os.environ.get("PROTEINA_COMPLEXA_ROOT", str(REPO_ROOT / "Proteina-Complexa"))
  27 | ).expanduser()
  28 | PROTEINA_CONFIG_NAME = "search_binder_local_pipeline"
  29 | PROTEINA_CONFIG_DIR = PROTEINA_ROOT / "configs"
  30 | PROTEINA_PYTHON = Path(
  31 |     os.environ.get("PROTEINA_PYTHON", sys.executable)
  32 | ).expanduser()
  33 | DEFAULT_TIMEOUT_SECONDS = 7200
  34 | 
  35 | _FORBIDDEN_CALLS = {"eval", "exec", "compile", "open", "__import__", "input"}
  36 | _ALLOWED_IMPORT_MODULES = {"__future__", "typing"}
  37 | _ALLOWED_SEARCH_ALGORITHMS = {"single-pass", "best-of-n", "beam-search", "fk-steering", "mcts"}
  38 | _ALLOWED_CHECKPOINT_ALIASES = {"complexa_default": "complexa.ckpt", "complexa": "complexa.ckpt"}
  39 | _ALLOWED_SCHEDULE_MODES = {"log", "power", "linear"}
  40 | _ALLOWED_NOISE_MODES = {"1/t", "tan", "power", "log", "linear"}
