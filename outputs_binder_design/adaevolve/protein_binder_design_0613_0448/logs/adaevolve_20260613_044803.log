 130 | def _as_int(value: Any, name: str, low: int, high: int) -> int:
 131 |     if isinstance(value, bool):
 132 |         raise CandidateValidationError(f"{name} must be an integer")
 133 |     try:
 134 |         out = int(value)
 135 |     except Exception as exc:
 136 |         raise CandidateValidationError(f"{name} must be an integer") from exc
 137 |     if out < low or out > high:
 138 |         raise CandidateValidationError(f"{name} must be between {low} and {high}")
 139 |     return out
