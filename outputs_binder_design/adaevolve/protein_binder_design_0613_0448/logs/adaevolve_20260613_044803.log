 309 | def _resolve_checkpoint(spec: dict[str, Any]) -> tuple[Path, str, Path]:
 310 |     ckpt_root = Path(os.environ.get("CKPT_PATH", str(PROTEINA_ROOT / "ckpts"))).expanduser()
 311 |     selection = spec["checkpoint_selection"]
 312 |     ckpt_name = _ALLOWED_CHECKPOINT_ALIASES.get(selection, selection)
 313 |     if "/" in ckpt_name or "\\" in ckpt_name or not ckpt_name.endswith(".ckpt"):
 314 |         raise CandidateValidationError("checkpoint_selection must be an allowed alias or checkpoint filename")
 315 |     ckpt_file = ckpt_root / ckpt_name
 316 |     ae_file = ckpt_root / "complexa_ae.ckpt"
 317 |     return ckpt_root, ckpt_name, ae_file
