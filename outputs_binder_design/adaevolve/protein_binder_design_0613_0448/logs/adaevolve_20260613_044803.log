 196 | def _normalise_spec(raw: dict[str, Any], *, stage: str) -> dict[str, Any]:
 197 |     sampling = raw.get("sampling", {})
 198 |     if sampling is None:
 199 |         sampling = {}
 200 |     if not isinstance(sampling, dict):
 201 |         raise CandidateValidationError("sampling must be a dict")
 202 | 
 203 |     search = raw.get("search", {})
 204 |     if search is None:
 205 |         search = {}
 206 |     if not isinstance(search, dict):
 207 |         raise CandidateValidationError("search must be a dict")
 208 | 
 209 |     algorithm = str(search.get("algorithm", "best-of-n"))
 210 |     if algorithm not in _ALLOWED_SEARCH_ALGORITHMS:
 211 |         raise CandidateValidationError(f"unsupported search algorithm: {algorithm!r}")
 212 | 
 213 |     nsteps = _as_int(raw.get("denoising_steps", 80), "denoising_steps", 10, 400)
 214 |     if stage == "stage1":
 215 |         nsteps = min(nsteps, _as_int(os.environ.get("SKYDISCOVER_BINDER_STAGE1_NSTEPS", 20), "stage1_nsteps", 5, 80))
 216 |     else:
 217 |         nsteps = min(nsteps, _as_int(os.environ.get("SKYDISCOVER_BINDER_MAX_NSTEPS", 120), "max_nsteps", 10, 400))
 218 | 
 219 |     batch_size = _as_int(raw.get("batch_size", 2), "batch_size", 1, 8)
 220 |     num_length_samples = _as_int(raw.get("num_length_samples", 2), "num_length_samples", 1, 8)
 221 |     if stage == "stage1":
 222 |         batch_size = min(batch_size, 1)
 223 |         num_length_samples = min(num_length_samples, 1)
 224 | 
 225 |     best_of_n = search.get("best_of_n", {}) if isinstance(search.get("best_of_n", {}), dict) else {}
 226 |     beam_search = search.get("beam_search", {}) if isinstance(search.get("beam_search", {}), dict) else {}
 227 |     fk_steering = search.get("fk_steering", {}) if isinstance(search.get("fk_steering", {}), dict) else {}
 228 |     mcts = search.get("mcts", {}) if isinstance(search.get("mcts", {}), dict) else {}
 229 | 
 230 |     spec = {
 231 |         "hotspot_residues": _normalise_hotspots(raw.get("hotspot_residues")),
 232 |         "binder_length": _normalise_length_range(raw.get("binder_length", [70, 110])),
 233 |         "checkpoint_selection": str(raw.get("checkpoint_selection", "complexa_default")),
 234 |         "denoising_steps": nsteps,
 235 |         "self_conditioning": bool(raw.get("self_conditioning", True)),
 236 |         "seed": _as_int(raw.get("seed", 7), "seed", 0, 2**31 - 1),
 237 |         "num_length_samples": num_length_samples,
 238 |         "batch_size": batch_size,
 239 |         "sampling": {
 240 |             "bb_ca_schedule": _normalise_schedule(
 241 |                 sampling.get("bb_ca_schedule", {"mode": "log", "p": 2.0}),
 242 |                 "bb_ca_schedule",
 243 |                 _ALLOWED_SCHEDULE_MODES,
 244 |             ),
 245 |             "local_latents_schedule": _normalise_schedule(
 246 |                 sampling.get("local_latents_schedule", {"mode": "power", "p": 2.0}),
 247 |                 "local_latents_schedule",
 248 |                 _ALLOWED_SCHEDULE_MODES,
 249 |             ),
 250 |             "bb_ca_noise": _normalise_schedule(
 251 |                 sampling.get("bb_ca_noise", {"mode": "1/t", "p": 1.0}),
 252 |                 "bb_ca_noise",
 253 |                 _ALLOWED_NOISE_MODES,
 254 |             ),
 255 |             "local_latents_noise": _normalise_schedule(
 256 |                 sampling.get("local_latents_noise", {"mode": "tan", "p": 1.0}),
 257 |                 "local_latents_noise",
 258 |                 _ALLOWED_NOISE_MODES,
 259 |             ),
 260 |             "bb_ca_sc_scale_noise": _as_float(sampling.get("bb_ca_sc_scale_noise", 0.1), "bb_ca_sc_scale_noise", 0.0, 2.0),
 261 |             "local_latents_sc_scale_noise": _as_float(
 262 |                 sampling.get("local_latents_sc_scale_noise", 0.1),
 263 |                 "local_latents_sc_scale_noise",
 264 |                 0.0,
 265 |                 2.0,
 266 |             ),
 267 |             "bb_ca_sc_scale_score": _as_float(sampling.get("bb_ca_sc_scale_score", 1.0), "bb_ca_sc_scale_score", 0.0, 5.0),
 268 |             "local_latents_sc_scale_score": _as_float(
 269 |                 sampling.get("local_latents_sc_scale_score", 1.0),
 270 |                 "local_latents_sc_scale_score",
 271 |                 0.0,
 272 |                 5.0,
 273 |             ),
 274 |         },
 275 |         "search": {
 276 |             "algorithm": algorithm,
 277 |             "best_of_n": {"replicas": _as_int(best_of_n.get("replicas", 2), "best_of_n.replicas", 1, 8)},
 278 |             "beam_search": {
