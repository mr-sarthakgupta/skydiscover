 218 | 
 219 |     batch_size = _as_int(raw.get("batch_size", 2), "batch_size", 1, 8)
 220 |     num_length_samples = _as_int(raw.get("num_length_samples", 2), "num_length_samples", 1, 8)
 221 |     if stage == "stage1":
 222 |         batch_size = min(batch_size, 1)
 223 |         num_length_samples = min(num_length_samples, 1)
