 324 | def _build_overrides(spec: dict[str, Any], root_path: Path) -> list[str]:
 325 |     ckpt_root, ckpt_name, ae_file = _resolve_checkpoint(spec)
 326 |     sampling = spec["sampling"]
 327 |     search = spec["search"]
 328 |     max_batch_size = max(
 329 |         spec["batch_size"],
 330 |         spec["batch_size"] * search["best_of_n"]["replicas"],
 331 |         spec["batch_size"] * search["beam_search"]["n_branch"] * search["beam_search"]["beam_width"],
 332 |     )
 333 | 
 334 |     return [
 335 |         f"++root_path={root_path}",
 336 |         "++run_name=skydiscover_3di3_il7ra",
 337 |         "++gen_njobs=1",
 338 |         f"++seed={spec['seed']}",
 339 |         f"++ckpt_path={ckpt_root}",
 340 |         f"++ckpt_name={ckpt_name}",
 341 |         f"++autoencoder_ckpt_path={ae_file}",
 342 |         f"++generation.task_name={TARGET_NAME}",
 343 |         f"++generation.target_dict_cfg.{TARGET_NAME}.source=skydiscover",
 344 |         f"++generation.target_dict_cfg.{TARGET_NAME}.target_filename=3di3_chain_b_il7ra_target",
 345 |         f"++generation.target_dict_cfg.{TARGET_NAME}.target_path={TARGET_PDB_PATH}",
