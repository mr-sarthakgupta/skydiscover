 246 |                 sampling.get("local_latents_schedule", {"mode": "power", "p": 2.0}),
 247 |                 "local_latents_schedule",
 248 |                 _ALLOWED_SCHEDULE_MODES,
 249 |             ),
 250 |             "bb_ca_noise": _normalise_schedule(
 251 |                 sampling.get("bb_ca_noise", {"mode": "1/t", "p": 1.0}),
 252 |                 "bb_ca_noise",
 253 |                 _ALLOWED_NOISE_MODES,
 254 |             ),
 255 |             "local_latents_noise": _normalise_schedule(
 256 |                 sampling.get("local_latents_noise", {"mode": "tan", "p": 1.0}),
 257 |                 "local_latents_noise",
 258 |                 _ALLOWED_NOISE_MODES,
 259 |             ),
 260 |             "bb_ca_sc_scale_noise": _as_float(sampling.get("bb_ca_sc_scale_noise", 0.1), "bb_ca_sc_scale_noise", 0.0, 2.0),
