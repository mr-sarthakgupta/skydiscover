 196 | def _normalise_spec(raw: dict[str, Any], *, stage: str) -> dict[str, Any]:
 197 |     sampling = raw.get("sampling", {})
 198 |     if sampling is None:
 199 |         sampling = {}
 200 |     if not isinstance(sampling, dict):
 201 |         raise CandidateValidationError("sampling must be a dict")
