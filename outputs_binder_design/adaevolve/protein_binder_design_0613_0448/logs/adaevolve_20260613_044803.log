 143 |     try:
 144 |         out = float(value)
 145 |     except Exception as exc:
 146 |         raise CandidateValidationError(f"{name} must be a number") from exc
 147 |     if not math.isfinite(out) or out < low or out > high:
 148 |         raise CandidateValidationError(f"{name} must be finite and between {low} and {high}")
