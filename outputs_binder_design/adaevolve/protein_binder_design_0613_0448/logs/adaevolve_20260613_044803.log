  62 | 
  63 | def _is_main_guard(node: ast.AST) -> bool:
  64 |     if not isinstance(node, ast.If) or node.orelse:
  65 |         return False
  66 |     test = node.test
  67 |     if not isinstance(test, ast.Compare) or len(test.ops) != 1 or len(test.comparators) != 1:
  68 |         return False
  69 |     return (
  70 |         isinstance(test.left, ast.Name)
  71 |         and test.left.id == "__name__"
  72 |         and isinstance(test.ops[0], ast.Eq)
  73 |         and isinstance(test.comparators[0], ast.Constant)
  74 |         and test.comparators[0].value == "__main__"
  75 |     )
