 375 |         f"++generation.model.local_latents.simulation_step_params.sc_scale_noise={sampling['local_latents_sc_scale_noise']}",
 376 |         f"++generation.model.bb_ca.simulation_step_params.sc_scale_score={sampling['bb_ca_sc_scale_score']}",
 377 |         f"++generation.model.local_latents.simulation_step_params.sc_scale_score={sampling['local_latents_sc_scale_score']}",
 378 |     ]
 379 | 
 380 | 
 381 | def _check_runtime_requirements(spec: dict[str, Any]) -> None:
 382 |     if not PROTEINA_ROOT.exists():
 383 |         raise RuntimeError(f"Proteina-Complexa repo not found: {PROTEINA_ROOT}")
 384 |     if not (PROTEINA_ROOT / "configs" / f"{PROTEINA_CONFIG_NAME}.yaml").exists():
 385 |         raise RuntimeError(f"Proteina config not found: {PROTEINA_CONFIG_NAME}")
 386 |     if not TARGET_PDB_PATH.exists():
 387 |         raise RuntimeError(f"target PDB not found: {TARGET_PDB_PATH}")
 388 | 
 389 |     ckpt_root, ckpt_name, ae_file = _resolve_checkpoint(spec)
 390 |     ckpt_file = ckpt_root / ckpt_name
 391 |     missing = []
 392 |     if not ckpt_file.exists():
 393 |         missing.append(str(ckpt_file))
 394 |     if not ae_file.exists():
 395 |         missing.append(str(ae_file))
 396 |     af2_dir = os.environ.get("AF2_DIR")
 397 |     if not af2_dir or not Path(af2_dir).exists():
 398 |         missing.append("AF2_DIR")
 399 |     if missing:
 400 |         raise RuntimeError(
 401 |             "missing Proteina runtime assets: "
 402 |             + ", ".join(missing)
 403 |             + ". Set CKPT_PATH and AF2_DIR, or run with SKYDISCOVER_BINDER_VALIDATE_ONLY=1 for schema checks."
 404 |         )
 405 | 
 406 | 
 407 | def _run_proteina_generate(spec: dict[str, Any], *, stage: str) -> dict[str, Any]:
 408 |     if os.environ.get("SKYDISCOVER_BINDER_VALIDATE_ONLY") == "1":
 409 |         return {
 410 |             "combined_score": 0.0,
 411 |             "validation_only": 1.0,
 412 |             "num_valid_designs": 0,
 413 |             "best_total_reward": 0.0,
 414 |             "mean_total_reward": 0.0,
 415 |             "selected_hotspots": ",".join(spec["hotspot_residues"]),
 416 |             "stage": stage,
 417 |         }
 418 | 
 419 |     _check_runtime_requirements(spec)
 420 |     timeout = int(os.environ.get("SKYDISCOVER_BINDER_TIMEOUT", DEFAULT_TIMEOUT_SECONDS))
 421 | 
 422 |     with tempfile.TemporaryDirectory(prefix=f"skydiscover_binder_{stage}_") as tmp:
 423 |         root_path = Path(tmp) / "generation"
 424 |         root_path.mkdir(parents=True, exist_ok=True)
 425 |         cmd = [
 426 |             str(PROTEINA_PYTHON),
 427 |             "-m",
 428 |             "proteinfoundation.generate",
 429 |             "--config-path",
 430 |             str(PROTEINA_CONFIG_DIR),
 431 |             "--config-name",
 432 |             PROTEINA_CONFIG_NAME,
 433 |             *_build_overrides(spec, root_path),
 434 |         ]
 435 |         env = os.environ.copy()
 436 |         env["HYDRA_FULL_ERROR"] = "1"
 437 |         src_path = str(PROTEINA_ROOT / "src")
 438 |         env["PYTHONPATH"] = src_path + (os.pathsep + env["PYTHONPATH"] if env.get("PYTHONPATH") else "")
 439 | 
 440 |         start = time.time()
 441 |         proc = subprocess.run(
 442 |             cmd,
 443 |             cwd=str(PROTEINA_ROOT),
 444 |             env=env,
 445 |             text=True,
 446 |             stdout=subprocess.PIPE,
 447 |             stderr=subprocess.PIPE,
 448 |             timeout=timeout,
 449 |             check=False,
 450 |         )
 451 |         elapsed = time.time() - start
 452 |         if proc.returncode != 0:
 453 |             raise RuntimeError(
 454 |                 f"Proteina generation failed with exit code {proc.returncode}\n"
 455 |                 f"STDOUT:\n{proc.stdout[-4000:]}\nSTDERR:\n{proc.stderr[-4000:]}"
 456 |             )
 457 |         reward_csvs = sorted(root_path.rglob("rewards_*.csv"))
 458 |         if not reward_csvs:
 459 |             raise RuntimeError(f"Proteina generation completed but no rewards_*.csv found under {root_path}")
 460 |         return _score_reward_csv(reward_csvs[-1], spec=spec, elapsed=elapsed, stage=stage)
 461 | 
 462 | 
 463 | def _finite_float(value: str | None) -> float | None:
 464 |     if value is None or value == "":
 465 |         return None
 466 |     try:
 467 |         parsed = float(value)
 468 |     except ValueError:
 469 |         return None
 470 |     return parsed if math.isfinite(parsed) else None
 471 | 
 472 | 
 473 | def _score_reward_csv(csv_path: Path, *, spec: dict[str, Any], elapsed: float, stage: str) -> dict[str, Any]:
 474 |     rows: list[dict[str, str]] = []
 475 |     with csv_path.open(newline="") as f:
 476 |         reader = csv.DictReader(f)
 477 |         rows.extend(reader)
 478 |     reward_rows = [(row, _finite_float(row.get("total_reward"))) for row in rows]
 479 |     reward_rows = [(row, reward) for row, reward in reward_rows if reward is not None]
 480 |     if not reward_rows:
 481 |         raise RuntimeError(f"no finite total_reward values found in {csv_path}")
 482 | 
 483 |     rewards = [reward for _, reward in reward_rows]
 484 |     best_row, best_reward = max(reward_rows, key=lambda item: item[1])
 485 |     mean_reward = sum(rewards) / len(rewards)
 486 |     # Proteina's default AF2 binder reward is often negative interface PAE loss.
 487 |     # Convert it to a bounded higher-is-better score while preserving ranking.
 488 |     penalty = max(0.0, -best_reward)
 489 |     combined = 1.0 / (1.0 + penalty)
 490 |     diversity_bonus = min(len({row.get("aatype", "") for row, _ in reward_rows}), 10) / 100.0
 491 |     combined_score = min(1.0, combined + diversity_bonus)
 492 | 
 493 |     numeric_components: dict[str, float] = {}
 494 |     for key in best_row:
 495 |         if key in {"pdb_path", "aatype", "sample_type", "metadata_tag"}:
 496 |             continue
 497 |         value = _finite_float(best_row.get(key))
 498 |         if value is not None:
 499 |             numeric_components[f"best_{key}"] = value
 500 | 
 501 |     return {
 502 |         "combined_score": float(combined_score),
 503 |         "best_total_reward": float(best_reward),
 504 |         "mean_total_reward": float(mean_reward),
 505 |         "num_valid_designs": float(len(reward_rows)),
 506 |         "eval_time": float(elapsed),
 507 |         "stage": stage,
 508 |         "selected_hotspot_count": float(len(spec["hotspot_residues"])),
 509 |         "binder_min_len": float(spec["binder_length"][0]),
 510 |         "binder_max_len": float(spec["binder_length"][1]),
 511 |         "denoising_steps": float(spec["denoising_steps"]),
 512 |         "selected_hotspots": ",".join(spec["hotspot_residues"]),
 513 |         "search_algorithm": spec["search"]["algorithm"],
 514 |         "reward_csv": str(csv_path),
 515 |         **numeric_components,
 516 |     }
 517 | 
 518 | 
 519 | def _failure(exc: Exception, *, stage: str) -> dict[str, Any]:
 520 |     return {
 521 |         "combined_score": 0.0,
 522 |         "best_total_reward": float("nan"),
 523 |         "mean_total_reward": float("nan"),
 524 |         "num_valid_designs": 0.0,
 525 |         "stage": stage,
 526 |         "error": str(exc),
 527 |     }
 528 | 
 529 | 
 530 | def _evaluate(program_path: str, *, stage: str) -> dict[str, Any]:
 531 |     try:
 532 |         raw_spec = _load_candidate_spec(program_path)
 533 |         spec = _normalise_spec(raw_spec, stage=stage)
 534 |         result = _run_proteina_generate(spec, stage=stage)
 535 |         result["spec_json"] = json.dumps(spec, sort_keys=True)
 536 |         print(
 537 |             "Evaluation: "
 538 |             f"stage={stage}, combined_score={result['combined_score']:.6f}, "
 539 |             f"best_total_reward={result['best_total_reward']}, "
 540 |             f"hotspots={result.get('selected_hotspots', '')}"
 541 |         )
 542 |         return result
 543 |     except Exception as exc:
 544 |         print(f"Evaluation failed: {exc}")
 545 |         traceback.print_exc()
 546 |         return _failure(exc, stage=stage)
 547 | 
 548 | 
 549 | def evaluate_stage1(program_path: str) -> dict[str, Any]:
 550 |     """Fast cascade stage for schema validation and a tiny Proteina run."""
 551 |     return _evaluate(program_path, stage="stage1")
 552 | 
 553 | 
 554 | def evaluate_stage2(program_path: str) -> dict[str, Any]:
 555 |     """Full benchmark stage for promising candidates."""
 556 |     return _evaluate(program_path, stage="stage2")
 557 | 
 558 | 
 559 | def evaluate(program_path: str) -> dict[str, Any]:
 560 |     """Evaluate one evolved Proteina binder-design run specification."""
 561 |     return evaluate_stage2(program_path)
 562 | 
 563 | 
 564 | if __name__ == "__main__":
 565 |     default_program = BENCHMARK_DIR / "initial_program.py"
 566 |     candidate = sys.argv[1] if len(sys.argv) > 1 else str(default_program)
 567 |     print(json.dumps(evaluate(candidate), indent=2, sort_keys=True))
