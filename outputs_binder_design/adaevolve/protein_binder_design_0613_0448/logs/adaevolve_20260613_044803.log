  43 | class CandidateValidationError(ValueError):
  44 |     """Raised when an evolved candidate violates the benchmark contract."""
  45 | 
  46 | 
  47 | def _load_metadata() -> dict[str, Any]:
  48 |     with TARGET_METADATA_PATH.open() as f:
  49 |         return json.load(f)
  50 | 
  51 | 
  52 | TARGET_METADATA = _load_metadata()
  53 | ALLOWED_HOTSPOTS = set(TARGET_METADATA["target"]["allowed_hotspots"])
  54 | INTERFACE_HOTSPOTS = [item["hotspot"] for item in TARGET_METADATA["interface_hotspot_candidates"]]
  55 | PRIOR_HOTSPOTS = TARGET_METADATA["prior_art_hotspots"]["hotspots"]
  56 | TARGET_PDB_PATH = ASSETS_DIR / TARGET_METADATA["target"]["target_pdb"]
  57 | 
  58 | 
  59 | def _is_module_docstring(node: ast.AST) -> bool:
  60 |     return isinstance(node, ast.Expr) and isinstance(node.value, ast.Constant) and isinstance(node.value.value, str)
  61 | 
  62 | 
  63 | def _is_main_guard(node: ast.AST) -> bool:
  64 |     if not isinstance(node, ast.If) or node.orelse:
  65 |         return False
  66 |     test = node.test
  67 |     if not isinstance(test, ast.Compare) or len(test.ops) != 1 or len(test.comparators) != 1:
  68 |         return False
  69 |     return (
  70 |         isinstance(test.left, ast.Name)
  71 |         and test.left.id == "__name__"
  72 |         and isinstance(test.ops[0], ast.Eq)
  73 |         and isinstance(test.comparators[0], ast.Constant)
  74 |         and test.comparators[0].value == "__main__"
  75 |     )
  76 | 
  77 | 
  78 | def _validate_candidate_source(program_path: str) -> None:
  79 |     source = Path(program_path).read_text()
  80 |     tree = ast.parse(source, filename=program_path)
  81 |     has_entrypoint = False
  82 | 
  83 |     for node in tree.body:
  84 |         if _is_module_docstring(node) or _is_main_guard(node):
  85 |             continue
  86 |         if isinstance(node, ast.ImportFrom):
  87 |             if node.module not in _ALLOWED_IMPORT_MODULES:
  88 |                 raise CandidateValidationError(f"import from {node.module!r} is not allowed")
  89 |             continue
  90 |         if isinstance(node, ast.Assign):
  91 |             try:
  92 |                 ast.literal_eval(node.value)
  93 |             except Exception as exc:
  94 |                 raise CandidateValidationError("top-level assignments must be literal constants") from exc
  95 |             continue
  96 |         if isinstance(node, ast.FunctionDef):
  97 |             if node.decorator_list:
  98 |                 raise CandidateValidationError("function decorators are not allowed")
  99 |             if node.name in {"propose_design_run", "run_discovery"}:
 100 |                 has_entrypoint = True
 101 |             for child in ast.walk(node):
 102 |                 if isinstance(child, (ast.Import, ast.ImportFrom)):
 103 |                     raise CandidateValidationError("imports inside evolved functions are not allowed")
 104 |                 if isinstance(child, ast.Call) and isinstance(child.func, ast.Name) and child.func.id in _FORBIDDEN_CALLS:
 105 |                     raise CandidateValidationError(f"call to {child.func.id}() is not allowed")
 106 |             continue
 107 |         raise CandidateValidationError(f"top-level {type(node).__name__} is not allowed")
 108 | 
 109 |     if not has_entrypoint:
 110 |         raise CandidateValidationError("candidate must define propose_design_run() or run_discovery()")
 111 | 
 112 | 
 113 | def _load_candidate_spec(program_path: str) -> dict[str, Any]:
 114 |     _validate_candidate_source(program_path)
 115 |     spec = importlib.util.spec_from_file_location("binder_candidate", program_path)
 116 |     if spec is None or spec.loader is None:
 117 |         raise CandidateValidationError(f"could not load candidate: {program_path}")
 118 |     module = importlib.util.module_from_spec(spec)
 119 |     spec.loader.exec_module(module)
 120 | 
 121 |     fn = getattr(module, "propose_design_run", None) or getattr(module, "run_discovery", None)
 122 |     if fn is None:
 123 |         raise CandidateValidationError("missing propose_design_run() or run_discovery()")
 124 |     result = fn()
 125 |     if not isinstance(result, dict):
 126 |         raise CandidateValidationError("candidate entry point must return a dict")
 127 |     return result
 128 | 
 129 | 
 130 | def _as_int(value: Any, name: str, low: int, high: int) -> int:
 131 |     if isinstance(value, bool):
 132 |         raise CandidateValidationError(f"{name} must be an integer")
 133 |     try:
 134 |         out = int(value)
 135 |     except Exception as exc:
 136 |         raise CandidateValidationError(f"{name} must be an integer") from exc
 137 |     if out < low or out > high:
 138 |         raise CandidateValidationError(f"{name} must be between {low} and {high}")
 139 |     return out
 140 | 
 141 | 
 142 | def _as_float(value: Any, name: str, low: float, high: float) -> float:
 143 |     try:
 144 |         out = float(value)
 145 |     except Exception as exc:
 146 |         raise CandidateValidationError(f"{name} must be a number") from exc
 147 |     if not math.isfinite(out) or out < low or out > high:
 148 |         raise CandidateValidationError(f"{name} must be finite and between {low} and {high}")
 149 |     return out
 150 | 
 151 | 
 152 | def _normalise_hotspots(value: Any) -> list[str]:
 153 |     if value is None:
 154 |         value = PRIOR_HOTSPOTS
 155 |     if not isinstance(value, (list, tuple)):
 156 |         raise CandidateValidationError("hotspot_residues must be a list")
 157 |     hotspots = []
 158 |     for item in value:
 159 |         if not isinstance(item, str):
 160 |             raise CandidateValidationError("hotspot residues must be strings like 'B84'")
 161 |         residue = item.strip().upper()
 162 |         if not re.fullmatch(r"B\d+[A-Z]?", residue):
 163 |             raise CandidateValidationError(f"invalid hotspot residue format: {item!r}")
 164 |         if residue not in ALLOWED_HOTSPOTS:
 165 |             raise CandidateValidationError(f"hotspot {residue!r} is not a modeled chain-B residue")
 166 |         if residue not in hotspots:
 167 |             hotspots.append(residue)
 168 |     if not 1 <= len(hotspots) <= 8:
 169 |         raise CandidateValidationError("choose between 1 and 8 hotspot residues")
 170 |     return hotspots
 171 | 
 172 | 
 173 | def _normalise_length_range(value: Any) -> list[int]:
 174 |     if not isinstance(value, (list, tuple)) or len(value) != 2:
 175 |         raise CandidateValidationError("binder_length must be [min_len, max_len]")
 176 |     low = _as_int(value[0], "binder_length[0]", 40, 220)
 177 |     high = _as_int(value[1], "binder_length[1]", 40, 220)
 178 |     if low > high:
 179 |         raise CandidateValidationError("binder_length minimum cannot exceed maximum")
 180 |     if high - low > 120:
 181 |         raise CandidateValidationError("binder_length range is too wide for this benchmark")
 182 |     return [low, high]
 183 | 
 184 | 
 185 | def _normalise_schedule(value: Any, name: str, allowed_modes: set[str]) -> dict[str, Any]:
 186 |     if value is None:
 187 |         value = {}
 188 |     if not isinstance(value, dict):
 189 |         raise CandidateValidationError(f"{name} must be a dict")
 190 |     mode = str(value.get("mode", "log" if "schedule" in name else "1/t"))
 191 |     if mode not in allowed_modes:
 192 |         raise CandidateValidationError(f"{name}.mode {mode!r} is unsupported")
 193 |     return {"mode": mode, "p": _as_float(value.get("p", 1.0), f"{name}.p", 0.05, 8.0)}
 194 | 
