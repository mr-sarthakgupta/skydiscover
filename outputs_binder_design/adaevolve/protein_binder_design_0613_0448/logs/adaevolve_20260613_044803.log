 152 | def _normalise_hotspots(value: Any) -> list[str]:
 153 |     if value is None:
 154 |         value = PRIOR_HOTSPOTS
 155 |     if not isinstance(value, (list, tuple)):
 156 |         raise CandidateValidationError("hotspot_residues must be a list")
 157 |     hotspots = []
 158 |     for item in value:
 159 |         if not isinstance(item, str):
 160 |             raise CandidateValidationError("hotspot residues must be strings like 'B84'")
 161 |         residue = item.strip().upper()
 162 |         if not re.fullmatch(r"B\d+[A-Z]?", residue):
 163 |             raise CandidateValidationError(f"invalid hotspot residue format: {item!r}")
 164 |         if residue not in ALLOWED_HOTSPOTS:
 165 |             raise CandidateValidationError(f"hotspot {residue!r} is not a modeled chain-B residue")
 166 |         if residue not in hotspots:
 167 |             hotspots.append(residue)
 168 |     if not 1 <= len(hotspots) <= 8:
 169 |         raise CandidateValidationError("choose between 1 and 8 hotspot residues")
 170 |     return hotspots
