 309 | def _resolve_checkpoint(spec: dict[str, Any]) -> tuple[Path, str, Path]:
 310 |     ckpt_root = Path(os.environ.get("CKPT_PATH", str(PROTEINA_ROOT / "ckpts"))).expanduser()
 311 |     selection = spec["checkpoint_selection"]
 312 |     ckpt_name = _ALLOWED_CHECKPOINT_ALIASES.get(selection, selection)
 313 |     if "/" in ckpt_name or "\\" in ckpt_name or not ckpt_name.endswith(".ckpt"):
 314 |         raise CandidateValidationError("checkpoint_selection must be an allowed alias or checkpoint filename")
 315 |     ckpt_file = ckpt_root / ckpt_name
 316 |     ae_file = ckpt_root / "complexa_ae.ckpt"
 317 |     return ckpt_root, ckpt_name, ae_file
 318 | 
 319 | 
 320 | def _hydra_list(values: list[Any]) -> str:
 321 |     return json.dumps(values, separators=(",", ":"))
 322 | 
 323 | 
 324 | def _build_overrides(spec: dict[str, Any], root_path: Path) -> list[str]:
 325 |     ckpt_root, ckpt_name, ae_file = _resolve_checkpoint(spec)
 326 |     sampling = spec["sampling"]
 327 |     search = spec["search"]
 328 |     max_batch_size = max(
 329 |         spec["batch_size"],
 330 |         spec["batch_size"] * search["best_of_n"]["replicas"],
 331 |         spec["batch_size"] * search["beam_search"]["n_branch"] * search["beam_search"]["beam_width"],
 332 |     )
 333 | 
 334 |     return [
 335 |         f"++root_path={root_path}",
 336 |         "++run_name=skydiscover_3di3_il7ra",
 337 |         "++gen_njobs=1",
 338 |         f"++seed={spec['seed']}",
 339 |         f"++ckpt_path={ckpt_root}",
 340 |         f"++ckpt_name={ckpt_name}",
 341 |         f"++autoencoder_ckpt_path={ae_file}",
 342 |         f"++generation.task_name={TARGET_NAME}",
 343 |         f"++generation.target_dict_cfg.{TARGET_NAME}.source=skydiscover",
 344 |         f"++generation.target_dict_cfg.{TARGET_NAME}.target_filename=3di3_chain_b_il7ra_target",
 345 |         f"++generation.target_dict_cfg.{TARGET_NAME}.target_path={TARGET_PDB_PATH}",
 346 |         f"++generation.target_dict_cfg.{TARGET_NAME}.target_input={TARGET_METADATA['target']['proteina_target_input']}",
 347 |         f"++generation.target_dict_cfg.{TARGET_NAME}.hotspot_residues={_hydra_list(spec['hotspot_residues'])}",
 348 |         f"++generation.target_dict_cfg.{TARGET_NAME}.binder_length={_hydra_list(spec['binder_length'])}",
 349 |         f"++generation.target_dict_cfg.{TARGET_NAME}.pdb_id=3di3",
 350 |         f"++generation.dataloader.batch_size={spec['batch_size']}",
 351 |         f"++generation.dataloader.dataset.nres.nsamples={spec['num_length_samples']}",
 352 |         f"++generation.args.nsteps={spec['denoising_steps']}",
 353 |         f"++generation.args.self_cond={str(spec['self_conditioning']).lower()}",
 354 |         f"++generation.search.algorithm={search['algorithm']}",
 355 |         f"++generation.search.max_batch_size={max_batch_size}",
 356 |         f"++generation.search.step_checkpoints={_hydra_list([0, spec['denoising_steps']])}",
 357 |         f"++generation.search.best_of_n.replicas={search['best_of_n']['replicas']}",
 358 |         f"++generation.search.beam_search.n_branch={search['beam_search']['n_branch']}",
 359 |         f"++generation.search.beam_search.beam_width={search['beam_search']['beam_width']}",
 360 |         f"++generation.search.fk_steering.n_branch={search['fk_steering']['n_branch']}",
 361 |         f"++generation.search.fk_steering.beam_width={search['fk_steering']['beam_width']}",
 362 |         f"++generation.search.fk_steering.temperature={search['fk_steering']['temperature']}",
 363 |         f"++generation.search.mcts.n_simulations={search['mcts']['n_simulations']}",
 364 |         f"++generation.search.mcts.exploration_prob={search['mcts']['exploration_prob']}",
 365 |         f"++generation.search.mcts.exploration_constant={search['mcts']['exploration_constant']}",
 366 |         f"++generation.model.bb_ca.schedule.mode={sampling['bb_ca_schedule']['mode']}",
 367 |         f"++generation.model.bb_ca.schedule.p={sampling['bb_ca_schedule']['p']}",
 368 |         f"++generation.model.local_latents.schedule.mode={sampling['local_latents_schedule']['mode']}",
 369 |         f"++generation.model.local_latents.schedule.p={sampling['local_latents_schedule']['p']}",
 370 |         f"++generation.model.bb_ca.gt.mode={sampling['bb_ca_noise']['mode']}",
 371 |         f"++generation.model.bb_ca.gt.p={sampling['bb_ca_noise']['p']}",
 372 |         f"++generation.model.local_latents.gt.mode={sampling['local_latents_noise']['mode']}",
 373 |         f"++generation.model.local_latents.gt.p={sampling['local_latents_noise']['p']}",
 374 |         f"++generation.model.bb_ca.simulation_step_params.sc_scale_noise={sampling['bb_ca_sc_scale_noise']}",
 375 |         f"++generation.model.local_latents.simulation_step_params.sc_scale_noise={sampling['local_latents_sc_scale_noise']}",
 376 |         f"++generation.model.bb_ca.simulation_step_params.sc_scale_score={sampling['bb_ca_sc_scale_score']}",
 377 |         f"++generation.model.local_latents.simulation_step_params.sc_scale_score={sampling['local_latents_sc_scale_score']}",
 378 |     ]
