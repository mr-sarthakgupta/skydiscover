 141 | 
 142 | def _as_float(value: Any, name: str, low: float, high: float) -> float:
 143 |     try:
 144 |         out = float(value)
 145 |     except Exception as exc:
 146 |         raise CandidateValidationError(f"{name} must be a number") from exc
 147 |     if not math.isfinite(out) or out < low or out > high:
 148 |         raise CandidateValidationError(f"{name} must be finite and between {low} and {high}")
 149 |     return out
 150 | 
 151 | 
 152 | def _normalise_hotspots(value: Any) -> list[str]:
 153 |     if value is None:
 154 |         value = PRIOR_HOTSPOTS
 155 |     if not isinstance(value, (list, tuple)):
 156 |         raise CandidateValidationError("hotspot_residues must be a list")
 157 |     hotspots = []
 158 |     for item in value:
 159 |         if not isinstance(item, str):
 160 |             raise CandidateValidationError("hotspot residues must be strings like 'B84'")
 161 |         residue = item.strip().upper()
 162 |         if not re.fullmatch(r"B\d+[A-Z]?", residue):
 163 |             raise CandidateValidationError(f"invalid hotspot residue format: {item!r}")
 164 |         if residue not in ALLOWED_HOTSPOTS:
 165 |             raise CandidateValidationError(f"hotspot {residue!r} is not a modeled chain-B residue")
 166 |         if residue not in hotspots:
 167 |             hotspots.append(residue)
 168 |     if not 1 <= len(hotspots) <= 8:
 169 |         raise CandidateValidationError("choose between 1 and 8 hotspot residues")
 170 |     return hotspots
 171 | 
 172 | 
 173 | def _normalise_length_range(value: Any) -> list[int]:
 174 |     if not isinstance(value, (list, tuple)) or len(value) != 2:
 175 |         raise CandidateValidationError("binder_length must be [min_len, max_len]")
 176 |     low = _as_int(value[0], "binder_length[0]", 40, 220)
 177 |     high = _as_int(value[1], "binder_length[1]", 40, 220)
 178 |     if low > high:
 179 |         raise CandidateValidationError("binder_length minimum cannot exceed maximum")
 180 |     if high - low > 120:
 181 |         raise CandidateValidationError("binder_length range is too wide for this benchmark")
 182 |     return [low, high]
 183 | 
