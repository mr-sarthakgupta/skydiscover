  78 | def _validate_candidate_source(program_path: str) -> None:
  79 |     source = Path(program_path).read_text()
  80 |     tree = ast.parse(source, filename=program_path)
  81 |     has_entrypoint = False
  82 | 
  83 |     for node in tree.body:
  84 |         if _is_module_docstring(node) or _is_main_guard(node):
  85 |             continue
  86 |         if isinstance(node, ast.ImportFrom):
  87 |             if node.module not in _ALLOWED_IMPORT_MODULES:
  88 |                 raise CandidateValidationError(f"import from {node.module!r} is not allowed")
  89 |             continue
  90 |         if isinstance(node, ast.Assign):
  91 |             try:
  92 |                 ast.literal_eval(node.value)
  93 |             except Exception as exc:
  94 |                 raise CandidateValidationError("top-level assignments must be literal constants") from exc
  95 |             continue
  96 |         if isinstance(node, ast.FunctionDef):
  97 |             if node.decorator_list:
  98 |                 raise CandidateValidationError("function decorators are not allowed")
  99 |             if node.name in {"propose_design_run", "run_discovery"}:
 100 |                 has_entrypoint = True
 101 |             for child in ast.walk(node):
 102 |                 if isinstance(child, (ast.Import, ast.ImportFrom)):
 103 |                     raise CandidateValidationError("imports inside evolved functions are not allowed")
 104 |                 if isinstance(child, ast.Call) and isinstance(child.func, ast.Name) and child.func.id in _FORBIDDEN_CALLS:
 105 |                     raise CandidateValidationError(f"call to {child.func.id}() is not allowed")
 106 |             continue
 107 |         raise CandidateValidationError(f"top-level {type(node).__name__} is not allowed")
 108 | 
 109 |     if not has_entrypoint:
 110 |         raise CandidateValidationError("candidate must define propose_design_run() or run_discovery()")
